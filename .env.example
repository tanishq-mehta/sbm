# Use this when you are ready to connect Supabase/Postgres.
# Keep your real .env private and do not commit it.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Supabase requires SSL for remote Postgres connections. Leave this as true.
DATABASE_SSL=true

# Authentication is configured outside the repo.
# Generate one user entry with:
# npm run auth:user -- admin "choose-a-strong-password"
#
# For multiple users, put the generated entries in one JSON array:
# AUTH_USERS_JSON='[{"username":"admin","passwordHash":"pbkdf2_sha256$..."}]'
AUTH_USERS_JSON=''

# Comma-separated usernames that can create, delete, and restore users.
# Usernames are case-insensitive and must also exist in AUTH_USERS_JSON.
AUTH_ADMIN_USERS=admin

# Generate with:
# npm run auth:secret
AUTH_SECRET=''

# Optional private photo storage through Cloudflare R2.
# Create an R2 bucket and an R2 API token with object read/write access.
R2_ACCOUNT_ID=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_BUCKET=''

# Optional: keep blank to store files as <badge-no>.jpg/png/webp at bucket root.
R2_IMAGE_PREFIX=''

# Optional: default is 3145728 bytes, which keeps uploads inside Vercel body limits.
PERSON_IMAGE_MAX_BYTES=3145728
